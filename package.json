{
    "private": true,
    "workspaces": [
        "client",
        "server"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "dev:server": "npm run dev:watch -w server",
        "dev:client": "npm start -w client",
        "format": "prettier --write \"**/*.{ts,js,json,css,scss,md,html}\" && eslint --fix \"server/src/**/*.{ts,js}\" \"client/src/**/*.{ts,html}\"",
        "lint": "eslint \"server/src/**/*.ts\" \"client/src/**/*.ts\" --fix",
        "lint:ci": "eslint \"server/src/**/*.ts\" \"client/src/**/*.ts\"",
        "prepare": "husky"
    },
    "doc": {
        "how_to_run": "pray to god "
    },
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@eslint-community/eslint-utils": "^4.9.0",
        "@typescript-eslint/eslint-plugin": "^8.47.0",
        "@typescript-eslint/parser": "^8.47.0",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.6",
        "prettier": "^3.6.2",
        "typescript-eslint": "^8.47.0"
    },
    "type": "module"
}
