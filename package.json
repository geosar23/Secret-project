{
    "private": true,
    "workspaces": [
        "client",
        "server",
        "packages/*"
    ],
    "scripts": {
        "format": "prettier --write \"**/*.{ts,js,json,css,scss,md}\" && eslint --fix \"server/src/**/*.{ts,js}\" \"client/src/**/*.{ts,js}\" \"packages/**/*.{ts,js}\" --ext .ts,.js",
        "lint": "eslint \"server/src/**/*.ts\" \"packages/**/*.ts\" --fix",
        "prepare": "husky"
    },
    "doc": {
        "how_to_run": "pray to god "
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.47.0",
        "@typescript-eslint/parser": "^8.47.0",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.6",
        "prettier": "^3.6.2",
        "typescript-eslint": "^8.47.0"
    },
    "type": "module"
}
