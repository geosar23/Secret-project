{
    "name": "hrms-backend",
    "version": "1.0.0",
    "description": "HRMS backend using Node, Express, TypeScript, MongoDB",
    "main": "dist/server.ts",
    "scripts": {
        "dev": "npx ts-node src/server.ts",
        "dev:watch": "npx nodemon src/server.ts",
        "build": "tsc",
        "start": "node dist/server.ts",
        "format": "prettier --write \"src/**/*.{ts,js,json,css,scss,md,html}\"",
        "lint": "eslint . --ext .ts"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.100.1",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.21.2",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^7.8.7",
        "morgan": "^1.10.1",
        "multer": "^2.1.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/helmet": "^4.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^1.4.12",
        "@types/node": "^18.19.130",
        "nodemon": "^3.1.11",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
