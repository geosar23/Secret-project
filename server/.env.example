# ── Required ─────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET=

# Supabase project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase service role key (server-side only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase storage bucket name
SUPABASE_STORAGE_BUCKET=hrms-saas

# Salary field encryption key — generate with: openssl rand -hex 32
SALARY_ENCRYPTION_KEY=

# ── Optional (defaults shown) ─────────────────────────────────────────────────

PORT=3000
NODE_ENV=production
JWT_EXPIRES_IN=7d

# Frontend origin(s) for CORS — comma-separated list
# Local dev + Docker: CLIENT_URL=http://localhost:4200,http://localhost
# Production: CLIENT_URL=https://your-app.com
CLIENT_URL=http://localhost:4200,http://localhost
