#!/usr/bin/env sh
set -e

# Keep track of files the user explicitly staged for this commit.
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$STAGED_FILES" ]; then
	exit 0
fi

npm run format
npm run lint

# Re-stage only files that were already staged, so auto-fixes are committed now.
echo "$STAGED_FILES" | while IFS= read -r file; do
	if [ -n "$file" ]; then
		git add -- "$file"
	fi
done
